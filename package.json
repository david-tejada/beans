{
	"name": "beans",
	"displayName": "Beans for Talon",
	"version": "0.2.0",
	"description": "Letter hints on every row of the VS Code sidebars, for Talon.",
	"categories": [
		"Other"
	],
	"keywords": [
		"accessibility",
		"explorer",
		"hints",
		"talon",
		"voice",
		"voice coding"
	],
	"homepage": "https://github.com/david-tejada/beans#readme",
	"bugs": {
		"url": "https://github.com/david-tejada/beans/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/david-tejada/beans"
	},
	"publisher": "david-tejada",
	"main": "./dist/extension.js",
	"scripts": {
		"dev": "node scripts/dev.mts",
		"build": "vp pack",
		"check": "vp check",
		"test": "vp test",
		"package": "vp pack && vsce package --no-dependencies",
		"prepare": "vp hooks enable"
	},
	"devDependencies": {
		"@types/node": "^20.19.43",
		"@types/vscode": "~1.90.0",
		"@vscode/vsce": "^4.1.0",
		"ovsx": "^1.3.0",
		"typescript": "^7.0.2",
		"vite-plus": "^1.4.0"
	},
	"contributes": {
		"commands": [
			{
				"command": "beans.toggle",
				"title": "Beans: Toggle hints"
			},
			{
				"command": "beans.inject",
				"title": "Beans: Inject the hint script"
			},
			{
				"command": "beans.relaunch",
				"title": "Beans: Relaunch with hints"
			}
		],
		"configuration": {
			"title": "Beans",
			"properties": {
				"beans.hintStyle": {
					"type": "string",
					"scope": "application",
					"default": "default",
					"enum": [
						"default",
						"compact"
					],
					"enumDescriptions": [
						"A pill with room for two letters, and VS Code's own space after the icon.",
						"A narrower pill, close to the icon and the name."
					],
					"description": "How the hints look."
				}
			}
		}
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"extensionKind": [
		"ui"
	],
	"icon": "media/icon.png",
	"preview": true,
	"engines": {
		"vscode": "^1.90.0"
	},
	"packageManager": "pnpm@12.11.2",
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		},
		"virtualWorkspaces": true
	}
}
