{
	// The hint script runs inside VS Code's window, a Chromium page: DOM
	// types, no Node.
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"target": "ES2022",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"types": [],
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["./**/*.ts", "../shared/**/*.ts"]
}
